# ---- Database (PostgreSQL in Azure) ----
DB_HOST=localhost
DB_PORT=your_port
DB_NAME=my_database
DB_USER=my_user
DB_PASSWORD=my_password
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ---- Sync settings ----
SYNC_LAYERS=my_layer
SYNC_INTERVAL_MS=500
SYNC_POLL_INTERVAL_MS=600000
SYNC_PAGE_SIZE=500
THIRD_PARTY_BASE_URL=http://localhost:3000/graphql
